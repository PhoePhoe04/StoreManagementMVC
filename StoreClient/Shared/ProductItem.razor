@using Store.Shared.DTOs
@inject StoreClient.Services.CartService CartService
@inject ToastService ToastService

<div class="card h-100 border-0 shadow-hover product-card">
    <div class="ratio ratio-4x3 position-relative overflow-hidden">
        @{
            // Khai báo đường dẫn Backend (Cổng 7177)
            string backendUrl = "https://localhost:7177";

            // Logic ghép đường dẫn hiển thị ảnh
            string imageUrl;
            if (string.IsNullOrEmpty(Product.ImageUrl))
            {
                imageUrl = $"{backendUrl}/images/default-image.png";
            }
            else
            {
                // Nếu ảnh đã có http thì giữ nguyên, nếu chưa thì nối backendUrl
                imageUrl = Product.ImageUrl.StartsWith("http")
                ? Product.ImageUrl
                : $"{backendUrl}{Product.ImageUrl}";
            }
        }

        <img src="@imageUrl"
             class="card-img-top object-fit-cover @(Product.Quantity == 0 ? "opacity-50" : "")"
             alt="@Product.ProductName"
             onerror="this.onerror=null;this.src='@backendUrl/images/default-image.png';">

        @if (Product.Quantity == 0)
        {
            <div class="position-absolute top-50 start-50 translate-middle badge bg-danger fs-5">HẾT HÀNG</div>
        }
    </div>

    <div class="card-body">
        <h6 class="card-title text-truncate fw-bold mb-1">
            <a href="/product/@Product.ProductId" class="text-decoration-none text-dark">@Product.ProductName</a>
        </h6>
        <p class="card-text text-danger fs-5 fw-bold mb-2">@Product.Price.ToString("N0") ₫</p>

        <small class="text-muted d-block mb-2">@Product.CategoryName</small>

        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Kho: <span class="fw-bold">@Product.Quantity</span></small>
        </div>
    </div>

    <div class="card-footer bg-white border-0 pt-0 text-end">
        @if (Product.Quantity > 0)
        {
            <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="AddToCart">
                <i class="bi bi-cart-plus me-1"></i> Thêm
            </button>
        }
        else
        {
            <button class="btn btn-outline-danger btn-sm rounded-pill px-3" disabled>Hết hàng</button>
        }
    </div>
</div>

@code {
    [Parameter]
    public ProductDTO Product { get; set; } = new();
    private async Task AddToCart()
    {
        // Tạo đối tượng CartItemDTO từ ProductDTO
        var cartItem = new CartItemDTO
            {
                ProductId = Product.ProductId,
                ProductName = Product.ProductName,
                Price = Product.Price,
                ImageUrl = Product.ImageUrl,

            // Số lượng mua mặc định là 1 (Khác với Product.Quantity là số lượng tồn kho)
                Quantity = 1
            };

        // Gọi Service để lưu vào LocalStorage
        await CartService.AddToCart(cartItem);

        ToastService.ShowSuccess($"Đã thêm {Product.ProductName} vào giỏ");
    }
}