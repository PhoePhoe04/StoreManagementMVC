@page "/history"
@using System.Net.Http.Headers
@using Store.Shared.Entities
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="container mt-4">
    <h3 class="mb-4 fw-bold text-primary">Lịch sử đơn hàng</h3>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Đang tải dữ liệu...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }
    else if (orders == null || orders.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-cart-x text-muted" style="font-size: 3rem;"></i>
            <h5 class="mt-3">Bạn chưa có đơn hàng nào</h5>
            <p class="text-muted">Hãy dạo một vòng cửa hàng và mua sắm ngay nhé!</p>
            <a href="/" class="btn btn-primary mt-2">Về trang chủ</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4">Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-4">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in orders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#@item.OrderId</td>
                                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold text-success">
                                        @item.TotalAmount.ToString("N0") ₫
                                    </td>
                                    <td>
                                        @if (item.Status?.ToLower() == "pending")
                                        {
                                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                        }
                                        else if (item.Status?.ToLower() == "completed")
                                        {
                                            <span class="badge bg-success">Hoàn thành</span>
                                        }
                                        else if (item.Status?.ToLower() == "cancelled")
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetails(item.OrderId)">
                                            Xem
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Order>? orders;
    private bool isLoading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. LẤY TOKEN (Giống hệt trang Profile)
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

            if (string.IsNullOrEmpty(token))
            {
                errorMessage = "Bạn chưa đăng nhập. Vui lòng đăng nhập để xem lịch sử.";
                isLoading = false;
                return;
            }

            // 2. GẮN HEADER
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            // 3. GỌI API (Đảm bảo Backend có Route này)
            // Lưu ý: Route này phải khớp với OrderApiController
            var response = await Http.GetAsync("api/order/my-orders");

            if (response.IsSuccessStatusCode)
            {
                orders = await response.Content.ReadFromJsonAsync<List<Order>>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Phiên đăng nhập hết hạn. Vui lòng đăng nhập lại.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // Nếu backend trả 404 nghĩa là chưa có đơn hàng nào
                orders = new List<Order>();
            }
            else
            {
                errorMessage = $"Lỗi tải dữ liệu: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Lỗi hệ thống: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ViewDetails(int orderId)
    {
        // Điều hướng sang trang chi tiết đơn hàng (nếu bạn làm sau này)
        // Navigation.NavigateTo($"/order-details/{orderId}");

        // Hoặc tạm thời alert
        Console.WriteLine($"Xem chi tiết đơn: {orderId}");
    }
}