@page "/forgot-password"
@inject HttpClient Http
@inject NavigationManager Nav
@layout AuthLayout

<div class="vh-100 bg-light d-flex align-items-center justify-content-center">
    <div class="card shadow-lg rounded-4 p-5" style="width: 600px;">
        <h2 class="text-center fw-bold mb-5">Quên mật khẩu</h2>

        <EditForm Model="@model" OnValidSubmit="@HandleForgot">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <InputText @bind-Value="model.Email"
                           class="form-control form-control-lg"
                           placeholder="Nhập email của bạn" />
            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg w-100"
                    disabled="@isSending">
                @(isSending ? "Đang gửi..." : "Gửi mã OTP")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="text-center mt-4 fw-medium @(success ? "text-success" : "text-danger")">
                @message
            </div>
        }

        <div class="text-center mt-4">
            <a href="/login" class="text-primary">&larr; Quay lại đăng nhập</a>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordDto model = new();
    private string message = "";
    private bool success = false;
    private bool isSending = false;

    private async Task HandleForgot()
    {
        isSending = true;
        message = "";
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/AuthApi/forgot-password", model);
            if (response.IsSuccessStatusCode)
            {
                success = true;
                message = "Mã OTP đã gửi đến email của bạn!";
                // Redirect sang reset-password kèm email query string
                Nav.NavigateTo($"/reset-password?email={Uri.EscapeDataString(model.Email)}");
            }
            else
            {
                success = false;
                message = "Email không tồn tại hoặc lỗi hệ thống.";
            }
        }
        catch (Exception ex)
        {
            success = false;
            message = "Lỗi hệ thống: " + ex.Message;
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    public class ForgotPasswordDto
    {
        public string Email { get; set; } = string.Empty;
    }
}
