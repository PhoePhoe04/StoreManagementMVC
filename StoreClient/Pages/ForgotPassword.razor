@page "/forgot-password"
@inject HttpClient Http
@inject NavigationManager Nav
@layout AuthLayout

<div class="vh-100 bg-light">
    <div class="container h-100">
        <div class="row justify-content-center align-items-center h-100">
            <div class="col-xl-10">
                <div class="card shadow-lg rounded-4">
                    <div class="card-body p-md-5">
                        <div class="row align-items-center">

                            <!-- Form -->
                            <div class="col-lg-6 order-2 order-lg-1">
                                <h2 class="text-center fw-bold mb-5">
                                    Quên mật khẩu
                                </h2>

                                <EditForm Model="@model" OnValidSubmit="HandleForgot">
                                    <DataAnnotationsValidator />

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            Email
                                        </label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text">
                                                <i class="bi bi-envelope-fill text-primary"></i>
                                            </span>
                                            <InputText @bind-Value="model.Email"
                                                       class="form-control"
                                                       placeholder="Nhập email của bạn" />
                                        </div>
                                    </div>

                                    <button type="submit"
                                            class="btn btn-primary btn-lg w-100">
                                        Gửi mã OTP
                                    </button>

                                    @if (!string.IsNullOrEmpty(message))
                                    {
                                        <div class="text-center mt-4 fw-medium
                                                @(message.Contains("gửi") ? "text-success" : "text-danger")">
                                            @message
                                        </div>
                                    }

                                    <div class="text-center mt-4">
                                        <a href="/login" class="text-primary">
                                            ← Quay lại đăng nhập
                                        </a>
                                    </div>
                                </EditForm>
                            </div>

                            <!-- Image -->
                            <div class="col-lg-6 order-1 order-lg-2 d-none d-lg-block">
                                <img src="https://img.freepik.com/free-vector/forgot-password-concept-illustration_114360-1095.jpg"
                                     class="img-fluid rounded"
                                     alt="Forgot password illustration" />
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordDto model = new();
    private string message = "";

    private async Task HandleForgot()
    {
        var response = await Http.PostAsJsonAsync("api/AuthApi/forgot-password", model);

        message = response.IsSuccessStatusCode
            ? "Mã OTP đã gửi đến email của bạn!"
            : "Email không tồn tại hoặc lỗi hệ thống.";
    }

    public class ForgotPasswordDto
    {
        public string Email { get; set; } = string.Empty;
    }
}
