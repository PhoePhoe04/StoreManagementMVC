@page "/login"
@layout StoreClient.Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="text-center">Đăng Nhập</h3>

<EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group mb-3">
        <label>Tên đăng nhập</label>
        <InputText @bind-Value="loginModel.Username" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>Mật khẩu</label>
        <InputText type="password" @bind-Value="loginModel.Password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary w-100" disabled="@IsSubmitting">
        @if (IsSubmitting)
        {
            <span>Đang xử lý...</span>
        }
        else
        {
            <span>Đăng Nhập</span>
        }
    </button>
</EditForm>

<div class="d-flex justify-content-between mt-3">
    <a href="/forgot-password">Quên mật khẩu?</a>
    <a href="/register">Đăng ký</a>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger mt-3">@ErrorMessage</div>
}

@code {
    private LoginModel loginModel = new();
    private bool IsSubmitting = false;
    private string ErrorMessage = "";

    private async Task HandleLogin()
    {
        ErrorMessage = "";
        IsSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login", loginModel);
            if (response.IsSuccessStatusCode)
            {
                var loginResp = await response.Content.ReadFromJsonAsync<LoginResponse>();
                if (loginResp != null && !string.IsNullOrWhiteSpace(loginResp.token))
                {
                    // Lưu token vào localStorage
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", loginResp.token);

                    // Thiết lập header Authorization cho HttpClient hiện tại
                    Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", loginResp.token);

                    Navigation.NavigateTo("/");
                    return;
                }

                ErrorMessage = "Đăng nhập thất bại: token không hợp lệ.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ErrorMessage = string.IsNullOrWhiteSpace(error) ? "Đăng nhập không thành công. Vui lòng thử lại." : error;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Không thể kết nối tới server: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
            StateHasChanged();
        }
    }

    public class LoginModel
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }

    private class LoginResponse
    {
        public string token { get; set; } = string.Empty;
        public string username { get; set; } = string.Empty;
        public string role { get; set; } = string.Empty;
    }
}