@page "/forgot-password"
@layout StoreClient.Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http

<h3 class="text-center">Quên Mật Khẩu</h3>

<EditForm Model="@forgotModel" OnValidSubmit="@HandleForgotPassword">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group mb-3">
        <label>Email</label>
        <InputText type="email" @bind-Value="forgotModel.Email" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Gửi Liên Kết Đặt Lại</button>
</EditForm>

<p class="text-center mt-3">
    <a href="/login">Quay lại Đăng Nhập</a>
</p>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info mt-3">@Message</div>
}

@code {
    private ForgotModel forgotModel = new();
    private string Message = "";

    private async Task HandleForgotPassword()
    {
        // Gọi API forgot password ở đây
        // Ví dụ: var response = await Http.PostAsJsonAsync("/api/auth/forgotpassword", forgotModel);

        Message = "Liên kết đặt lại mật khẩu đã được gửi đến email của bạn.";
        StateHasChanged();
    }

    public class ForgotModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";
    }
}