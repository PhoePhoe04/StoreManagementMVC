@page "/cart"
@using StoreClient.Services

@inject CartService CartService
@inject ToastService ToastService
@inject NavigationManager NavManager

<PageTitle>Giỏ hàng của bạn</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4 fw-bold">Giỏ hàng (@cartItems.Count sản phẩm)</h3>

    @if (cartItems.Count == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <p class="mt-3 fs-5">Giỏ hàng của bạn đang trống.</p>
            <a href="products" class="btn btn-primary mt-2">Đi mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        @foreach (var item in cartItems)
                        {
                            <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                <img src="@($"https://picsum.photos/100?random={item.ProductId}")"
                                     class="rounded me-3" style="width: 80px; height: 80px; object-fit: cover;">

                                <div class="flex-grow-1">
                                    <h5 class="mb-1">@item.ProductName</h5>
                                    <p class="text-danger fw-bold mb-0">@item.Price.ToString("N0") ₫</p>
                                </div>

                                <div class="d-flex align-items-center me-4">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => DecreaseQty(item)">-</button>
                                    <span class="mx-2 fw-bold" style="width: 20px; text-align: center;">@item.Quantity</span>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => IncreaseQty(item)">+</button>
                                </div>

                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveItem(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">Cộng giỏ hàng</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span class="fw-bold">@TotalPrice.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4 fs-5 fw-bold">
                            <span>Tổng cộng:</span>
                            <span class="text-danger">@TotalPrice.ToString("N0") ₫</span>
                        </div>
                        <button class="btn btn-primary w-100 py-2 fw-bold rounded-pill" 
                                @onclick="GoToCheckout">
                            TIẾN HÀNH THANH TOÁN
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CartItem> cartItems = new();

    // Tính tổng tiền tự động mỗi khi cartItems thay đổi
    private decimal TotalPrice => cartItems.Sum(i => i.Price * i.Quantity);

    protected override void OnInitialized()
    {
        LoadCart();
        // Lắng nghe thay đổi (để cập nhật giao diện nếu xóa item từ nơi khác)
        CartService.OnChange += LoadCart;
    }

    private void LoadCart()
    {
        cartItems = CartService.GetCartItems();
        StateHasChanged();
    }

    // Xử lý tăng giảm số lượng ngay tại trang
    private void IncreaseQty(CartItem item)
    {
        if (item.Quantity < item.StockQuantity) item.Quantity++;
    }

    private void DecreaseQty(CartItem item)
    {
        if (item.Quantity > 1) item.Quantity--;
        else CartService.DeleteItem(item); // Nếu giảm về 0 thì xóa luôn
    }

    // Hàm xóa item
    private void RemoveItem(CartItem item)
    {
        CartService.DeleteItem(item);
    }

    public void Dispose()
    {
        CartService.OnChange -= LoadCart;
    }

    private void GoToCheckout()
    {
        // Chuyển hướng sang trang Checkout mà chúng ta vừa tạo
        NavManager.NavigateTo("/checkout");
    }
}