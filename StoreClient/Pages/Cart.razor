@page "/cart"
@using Store.Shared.DTOs
@using StoreClient.Services

@inject CartService CartService
@inject NavigationManager NavManager
@inject ToastService ToastService

<PageTitle>Giỏ hàng của bạn</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4 fw-bold text-primary">Giỏ hàng (@cartItems.Count sản phẩm)</h3>

    @if (cartItems.Count == 0)
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <p class="mt-3 fs-5">Giỏ hàng của bạn đang trống.</p>
            <a href="products" class="btn btn-primary mt-2">Đi mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        @{
                            string backendUrl = "https://localhost:7177";
                        }

                        @foreach (var item in cartItems)
                        {
                            <div class="d-flex align-items-center mb-3 pb-3 border-bottom">

                                <img src="@(string.IsNullOrEmpty(item.ImageUrl)
                                    ? $"{backendUrl}/images/default-image.png"
                                    : (item.ImageUrl.StartsWith("http") ? item.ImageUrl : $"{backendUrl}{item.ImageUrl}"))"
                                     class="rounded me-3 border"
                                     style="width: 80px; height: 80px; object-fit: cover;"
                                     alt="@item.ProductName"
                                     onerror="this.onerror=null; this.src='@backendUrl/images/default-image.png';">

                                <div class="flex-grow-1">
                                    <h5 class="mb-1 text-dark">@item.ProductName</h5>
                                    <p class="text-danger fw-bold mb-0">@item.Price.ToString("N0") ₫</p>
                                </div>

                                <div class="d-flex align-items-center me-4">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => DecreaseQty(item)">-</button>
                                    <span class="mx-2 fw-bold" style="width: 30px; text-align: center;">@item.Quantity</span>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => IncreaseQty(item)">+</button>
                                </div>

                                <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveItem(item)" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">Cộng giỏ hàng</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span class="fw-bold">@TotalPrice.ToString("N0") ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4 fs-5 fw-bold">
                            <span>Tổng cộng:</span>
                            <span class="text-danger">@TotalPrice.ToString("N0") ₫</span>
                        </div>
                        <button class="btn btn-primary w-100 py-2 fw-bold rounded-pill"
                                @onclick="GoToCheckout">
                            TIẾN HÀNH THANH TOÁN
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Lưu ý: Kiểm tra kỹ tên class là CartItemDto hay CartItemDTO trong project Shared của bạn nhé
    private List<CartItemDTO> cartItems = new();

    private decimal TotalPrice => cartItems.Sum(i => i.Price * i.Quantity);

    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
        // Đăng ký sự kiện bằng tên hàm cụ thể
        CartService.OnChange += HandleCartChanged;
    }

    // Hàm xử lý sự kiện (phải là async void để khớp với delegate Action)
    private async void HandleCartChanged()
    {
        await LoadCart();
    }

    private async Task LoadCart()
    {
        cartItems = await CartService.GetCartItems();
        StateHasChanged();
    }

    private async Task IncreaseQty(CartItemDTO item)
    {
        item.Quantity++;
        await CartService.SaveCart(cartItems);
    }

    private async Task DecreaseQty(CartItemDTO item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
            await CartService.SaveCart(cartItems);
        }
        else
        {
            await RemoveItem(item);
        }
    }

    private async Task RemoveItem(CartItemDTO item)
    {
        await CartService.DeleteItem(item);
        // Không cần gọi LoadCart() ở đây nữa vì DeleteItem bên Service đã kích hoạt sự kiện OnChange rồi
        // HandleCartChanged sẽ tự chạy để cập nhật UI
        ToastService.ShowSuccess($"Đã xóa {item.ProductName} khỏi giỏ hàng");
    }

    public void Dispose()
    {
        // Hủy đăng ký sự kiện chính xác (tránh lỗi memory leak)
        CartService.OnChange -= HandleCartChanged;
    }

    private void GoToCheckout()
    {
        NavManager.NavigateTo("/checkout");
    }
}