@page "/reset-password"
@inject HttpClient Http
@inject NavigationManager Nav
@layout AuthLayout
@using Microsoft.AspNetCore.Components

<div class="vh-100 bg-light d-flex align-items-center justify-content-center">
    <div class="card shadow-lg rounded-4 p-5" style="width: 600px;">
        <h2 class="text-center mb-4">Đặt lại mật khẩu</h2>

        <EditForm Model="@model" OnValidSubmit="@HandleReset">
            <DataAnnotationsValidator />

            <InputText @bind-Value="model.Email" placeholder="Email" class="form-control mb-3" />
            <InputText @bind-Value="model.Otp" placeholder="Mã OTP" class="form-control mb-3" />
            <InputText @bind-Value="model.NewPassword" type="password" placeholder="Mật khẩu mới" class="form-control mb-3" />

            <button type="submit" class="btn btn-primary w-100" disabled="@isSending">
                @(isSending ? "Đang xử lý..." : "Đổi mật khẩu")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="mt-3 text-center @(success ? "text-success" : "text-danger")">@message</div>
        }

        <div class="text-center mt-3">
            <a href="/login" class="text-primary">&larr; Quay lại đăng nhập</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string Email { get; set; } = "";

    private ResetPasswordDto model = new();
    private string message = "";
    private bool success = false;
    private bool isSending = false;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            model.Email = Email;
        }
    }

    private async Task HandleReset()
    {
        isSending = true;
        message = "";
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/AuthApi/reset-password", model);
            if (response.IsSuccessStatusCode)
            {
                success = true;
                message = "Đổi mật khẩu thành công!";
                StateHasChanged();

                // Redirect về login sau 2 giây
                await Task.Delay(2000);
                Nav.NavigateTo("/login");
            }
            else
            {
                success = false;
                message = "OTP sai hoặc đã hết hạn.";
            }
        }
        catch (Exception ex)
        {
            success = false;
            message = "Lỗi hệ thống: " + ex.Message;
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }

    public class ResetPasswordDto
    {
        public string Email { get; set; } = "";
        public string Otp { get; set; } = "";
        public string NewPassword { get; set; } = "";
    }
}
