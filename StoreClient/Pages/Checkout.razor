@page "/checkout"
@using Store.Shared.DTOs
@using Store.Shared.Entities
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Nav
@inject CartService CartService
@inject IJSRuntime JS
@inject ToastService ToastService

<div class="container mt-4">
    <h3 class="mb-3 text-primary">Thanh toán đơn hàng</h3>

    <div class="row">
        <div class="col-md-7">
            <div class="card p-4 mb-3 shadow-sm">
                <h5 class="fw-bold">Thông tin nhận hàng</h5>
                <EditForm Model="orderRequest" OnValidSubmit="PlaceOrder">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label>Họ tên người nhận</label>
                        <InputText @bind-Value="orderRequest.ReceiveName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Số điện thoại</label>
                        <InputText @bind-Value="orderRequest.ReceivePhone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Địa chỉ</label>
                        <InputTextArea @bind-Value="orderRequest.ReceiveAddress" class="form-control" rows="2" />
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 mt-3 fw-bold">
                        XÁC NHẬN ĐẶT HÀNG (@FinalTotal.ToString("N0") ₫)
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card p-3 bg-light shadow-sm">
                <h5 class="fw-bold">Đơn hàng của bạn</h5>
                <hr />
                @foreach (var item in cartItems)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>@item.Quantity x @item.ProductName</span>
                        <span class="fw-bold">@((item.Price * item.Quantity).ToString("N0")) ₫</span>
                    </div>
                }
                <hr />

                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="Mã giảm giá"
                           @bind="inputCouponCode" disabled="@(isCouponApplied)">
                    @if (isCouponApplied)
                    {
                        <button class="btn btn-danger" @onclick="RemoveCoupon">Bỏ</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="ApplyCoupon">Áp dụng</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(couponMessage))
                {
                    <div class="alert @(isCouponApplied ? "alert-success" : "alert-danger") p-2 small">
                        @couponMessage
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <span>Tạm tính:</span>
                    <span>@SubTotal.ToString("N0") ₫</span>
                </div>

                @if (isCouponApplied)
                {
                    <div class="d-flex justify-content-between text-success">
                        <span>
                            Giảm giá
                            @if (promoResult.DiscountType == "percent")
                            {
                                <span>(@promoResult.DiscountValue%)</span>
                            }
                        </span>
                        <span>-@DiscountAmount.ToString("N0") ₫</span>
                    </div>
                }

                <hr>
                <div class="d-flex justify-content-between fs-4 fw-bold text-danger">
                    <span>Tổng cộng:</span>
                    <span>@FinalTotal.ToString("N0") ₫</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateOrderRequest orderRequest = new();
    private List<CartItemDTO> cartItems = new();

    // Biến cho Promotion
    private string inputCouponCode = "";
    private bool isCouponApplied = false;
    private decimal discountPercent = 0;
    private string couponMessage = "";
    private PromotionCheckResult promoResult = new();

    // Các biến tính toán hiển thị
    private decimal SubTotal => cartItems.Sum(i => i.Price * i.Quantity);

    private decimal DiscountAmount
    {
        get
        {
            if (!isCouponApplied) return 0;

            // Logic giống hệt Server
            if (promoResult.DiscountType == "percent")
            {
                return SubTotal * (promoResult.DiscountValue / 100);
            }
            else // "fixed"
            {
                return promoResult.DiscountValue;
            }
        }
    }

    private decimal FinalTotal
    {
        get
        {
            var total = SubTotal - DiscountAmount;
            return total < 0 ? 0 : total; // Không để âm tiền
        }
    }

    protected override async Task OnInitializedAsync()
    {
        cartItems = await CartService.GetCartItems();
        if (cartItems.Count == 0) Nav.NavigateTo("/");

        // Lấy token và info customer (giữ nguyên logic cũ của bạn)
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/login?returnUrl=/checkout"); return; }

        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        try
        {
            var customer = await Http.GetFromJsonAsync<Customer>("api/customer/profile");
            if (customer != null)
            {
                orderRequest.ReceiveName = customer.Name;
                orderRequest.ReceivePhone = customer.Phone ?? "";
                orderRequest.ReceiveAddress = customer.Address ?? "";
            }
        }
        catch { }
    }

    private async Task ApplyCoupon()
    {
        if (string.IsNullOrWhiteSpace(inputCouponCode)) return;

        var response = await Http.GetAsync($"api/promotion/check/{inputCouponCode}");

        if (response.IsSuccessStatusCode)
        {
            // 👇 SỬA Ở ĐÂY: Thêm "?? new()" để đảm bảo không bao giờ bị null
            promoResult = await response.Content.ReadFromJsonAsync<PromotionCheckResult>()
                          ?? new PromotionCheckResult();

            // Kiểm tra MinOrderAmount ngay tại Client để báo khách biết
            if (SubTotal < promoResult.MinOrderAmount)
            {
                couponMessage = $"Đơn hàng phải từ {promoResult.MinOrderAmount:N0}đ mới dùng được mã này.";
                isCouponApplied = false;
                orderRequest.PromotionCode = null;

                // Hiện Toast lỗi (nếu bạn đã inject ToastService)
                ToastService.ShowError(couponMessage);
            }
            else
            {
                isCouponApplied = true;
                couponMessage = "Áp dụng mã thành công!";
                orderRequest.PromotionCode = promoResult.PromoCode;

                // Có thể thêm Toast success nếu muốn
                ToastService.ShowSuccess($"Giảm {(promoResult.DiscountType == "percent" ? promoResult.DiscountValue + "%" : promoResult.DiscountValue.ToString("N0") + "đ")}");
            }
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            // Clean chuỗi lỗi nếu API trả về dạng "Lỗi..."
            couponMessage = error.Trim('"');
            ToastService.ShowError(couponMessage); // Hiện Toast lỗi cho đẹp
            RemoveCoupon();
        }
    }

    private void RemoveCoupon()
    {
        isCouponApplied = false;
        inputCouponCode = "";
        couponMessage = "";
        orderRequest.PromotionCode = null;
        promoResult = new PromotionCheckResult();
    }

    private async Task PlaceOrder()
    {
        orderRequest.CartItems = cartItems;
        // orderRequest.PromotionCode đã được gán ở hàm ApplyCoupon rồi

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PostAsJsonAsync("api/order/create", orderRequest);

        if (response.IsSuccessStatusCode)
        {
            await CartService.ClearCart();
            ToastService.ShowSuccess("Đặt hàng thành công!");
            Nav.NavigateTo("/history");
        }
        else
        {
            var err = await response.Content.ReadAsStringAsync();
            ToastService.ShowError("Lỗi: " + err);
        }
    }
}