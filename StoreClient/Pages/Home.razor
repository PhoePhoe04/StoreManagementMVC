@page "/"
@inject HttpClient Http
@using Store.Shared
@using StoreClient.Shared 

<PageTitle>Trang chủ - MyStore</PageTitle>

<div class="bg-dark text-white text-center py-5 mb-5" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://picsum.photos/1200/400'); background-size: cover; background-position: center;">
    <div class="container py-5">
        <h1 class="display-4 fw-bold">Siêu Sale Mùa Hè</h1>
        <p class="lead mb-4">Giảm giá lên đến 50% cho các sản phẩm thời trang.</p>
        <a href="products" class="btn btn-warning btn-lg fw-bold px-5 rounded-pill">Mua ngay</a>
    </div>
</div>

<div class="container mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0 text-primary"><i class="bi bi-stars"></i> Sản phẩm bán chạy</h3>
    </div>

    @if (featuredProducts == null)
    {
        <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
            @foreach (var p in featuredProducts)
            {
                <div class="col">
                    <ProductItem Product="@p" />
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Sản phẩm mới nhất</h3>
        <a href="products" class="text-decoration-none">Xem tất cả <i class="bi bi-arrow-right"></i></a>
    </div>

    @if (latestProducts == null)
    {
        <div class="text-center py-3"><div class="spinner-border text-secondary"></div></div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var p in latestProducts)
            {
                <div class="col">
                    <ProductItem Product="@p" />
                </div>
            }
        </div>
    }
</div>

@code {
    @code {
        private List<ProductDTO>? featuredProducts;
        private List<ProductDTO>? latestProducts;

        protected override async Task OnInitializedAsync()
        {
            try
            {
                // Gọi API Featured 
                featuredProducts = await Http.GetFromJsonAsync<List<ProductDTO>>("api/ProductApi/featured");

                // Gọi API Latest
                latestProducts = await Http.GetFromJsonAsync<List<ProductDTO>>("api/ProductApi/latest");
            }
            catch (Exception ex)
            {
                Console.WriteLine("Lỗi Home: " + ex.Message);
            }
        }
    }
}