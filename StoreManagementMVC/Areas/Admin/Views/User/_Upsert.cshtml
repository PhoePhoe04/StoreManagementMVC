@using Store.Shared.Entities
@model User

<form id="upsertForm">
    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        <label class="form-label fw-bold">Tên đăng nhập (Username)</label>
        <input asp-for="Username" class="form-control" required placeholder="Nhập tên đăng nhập" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Họ và tên</label>
        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Mật khẩu</label>
        <input asp-for="Password" type="password" class="form-control" placeholder="@(Model.UserId > 0 ? "Để trống nếu không đổi mật khẩu" : "Nhập mật khẩu")" />
        @if (Model.UserId == 0)
        {
            <small class="text-danger">* Bắt buộc nhập khi thêm mới</small>
        }
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Vai trò (Role)</label>
        <select asp-for="Role" class="form-select">
            <option value="staff">Nhân viên (Staff)</option>
            <option value="admin">Quản trị viên (Admin)</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Email</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="example@mail.com" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Vai trò</label>
        <select asp-for="Role" class="form-select">
            @if (ViewBag.Type == "employee")
            {
                <option value="staff">Nhân viên</option>
                <option value="admin">Quản trị viên</option>
            }
            else
            {
                <option value="customer">Khách hàng (User)</option>
            }
        </select>
    </div>

    <div class="text-end border-top pt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary px-4">Lưu thông tin</button>
    </div>
</form>