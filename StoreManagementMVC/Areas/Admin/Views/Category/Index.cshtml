@model List<Store.Shared.Entities.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-primary fw-bold">Danh sách Danh mục</h3>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex">
            <input type="text" name="search" value="@search" class="form-control me-2" placeholder="Tìm tên danh mục..." style="width: 250px;">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
        </form>

        <button onclick="openModal()" class="btn btn-primary shadow-sm text-nowrap">
            <i class="bi bi-plus-lg me-1"></i> Thêm mới
        </button>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary">
                <tr>
                    <th class="ps-3" style="width: 50px;">ID</th>
                    <th>Tên danh mục</th>
                    <th class="text-center" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 text-muted">#@item.CategoryId</td>
                            <td class="fw-bold">@item.CategoryName</td>

                            <td class="text-center">
                                <button onclick="openModal(@item.CategoryId)" class="btn btn-sm btn-outline-warning me-1" title="Sửa"><i class="bi bi-pencil"></i></button>
                                <button onclick="deleteCategory(@item.CategoryId)" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">Không tìm thấy danh mục nào</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { p = currentPage - 1, search = search })">Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { p = i, search = search })">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { p = currentPage + 1, search = search })">Sau</a>
            </li>
        </ul>
    </nav>
}

<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Thông tin Danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hàm mở modal Thêm/Sửa
        function openModal(id = null) {
            $('#categoryModal').modal('show');
            $('#modalBody').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');

            let baseUrl = '@Url.Action("Upsert", "Category", new { area = "Admin" })';
            let url = id ? `${baseUrl}?id=${id}` : baseUrl;

            $.get(url, function (data) {
                $('#modalBody').html(data);

                // Gắn sự kiện submit cho form sau khi load xong
                $('#upsertForm').submit(function (e) {
                    e.preventDefault();
                    let postUrl = '@Url.Action("Upsert", "Category", new { area = "Admin" })';
                    $.post(postUrl, $(this).serialize(), function (res) {
                        if (res.success) {
                            $('#categoryModal').modal('hide');
                            Swal.fire({ icon: 'success', title: 'Thành công', timer: 1000, showConfirmButton: false }).then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                });
            }).fail(function() {
                $('#modalBody').html('<div class="text-center text-danger">Lỗi tải dữ liệu</div>');
            });
        }

        // Hàm xóa
        function deleteCategory(id) {
            Swal.fire({
                title: 'Xóa danh mục này?', text: "Dữ liệu sẽ mất vĩnh viễn!", icon: 'warning',
                showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    let deleteUrl = '@Url.Action("Delete", "Category", new { area = "Admin" })';
                    $.post(deleteUrl, { id: id }, function (res) {
                        if (res.success) Swal.fire('Đã xóa', '', 'success').then(() => location.reload());
                        else Swal.fire('Lỗi', res.message, 'error');
                    });
                }
            })
        }
    </script>
}