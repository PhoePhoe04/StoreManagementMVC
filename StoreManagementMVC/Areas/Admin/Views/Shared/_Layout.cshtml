<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Cửa Hàng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.1/font/bootstrap-icons.min.css">

    <style>
        /* CSS cho giao diện App-like */
        html, body { height: 100vh; margin: 0; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .wrapper { height: 100vh; display: flex; width: 100%; }

        /* Sidebar */
        .sidebar { width: 250px; background-color: #212529; color: white; display: flex; flex-direction: column; flex-shrink: 0; }
        .sidebar a { color: #adb5bd; text-decoration: none; padding: 12px 20px; display: block; border-left: 3px solid transparent; transition: 0.2s; }
        .sidebar a:hover { background-color: #343a40; color: white; }
        .sidebar a.active { background-color: #343a40; color: #fff; border-left: 3px solid #0d6efd; font-weight: 500; }

        /* Main Panel */
        .main-panel { flex-grow: 1; display: flex; flex-direction: column; height: 100vh; background-color: #f8f9fa; }
        .top-navbar { flex-shrink: 0; background: white; border-bottom: 1px solid #dee2e6; padding: 15px 25px; box-shadow: 0 2px 4px rgba(0,0,0,.02); }

        /* Content Scrollable */
        .content-scrollable { flex-grow: 1; overflow-y: auto; padding: 25px; padding-bottom: 80px; }

        /* Custom Scrollbar */
        .content-scrollable::-webkit-scrollbar { width: 8px; }
        .content-scrollable::-webkit-scrollbar-track { background: transparent; }
        .content-scrollable::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; border: 3px solid transparent; background-clip: content-box; }
        .content-scrollable::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="sidebar">
            <div class="d-flex align-items-center p-3 text-white border-bottom border-secondary" style="height: 60px;">
                <i class="bi bi-shop fs-4 me-2"></i> <span class="fs-5 fw-bold">Store Admin</span>
            </div>
            <ul class="nav nav-pills flex-column mb-auto mt-2">
                <li>
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2 me-2"></i> Tổng quan
                    </a>
                </li>

                @{
                    // --- LOGIC XỬ LÝ TRẠNG THÁI MENU ---
                    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();

                    // Logic cho Menu Kho
                    var isProductMenuOpen = currentCtrl == "Product" || currentCtrl == "Category";

                    // Logic cho Menu Tài khoản
                    // Lấy tham số 'type' từ URL để biết đang xem Nhân viên hay Khách hàng
                    var currentType = Context.Request.Query["type"].ToString();
                    var isUserMenuOpen = currentCtrl == "User";
                }

                <li>
                    <a href="#subMenuProduct" data-bs-toggle="collapse"
                       class="d-flex justify-content-between align-items-center @(isProductMenuOpen ? "active" : "")"
                       aria-expanded="@(isProductMenuOpen ? "true" : "false")">
                        <span><i class="bi bi-box-seam me-2"></i> Quản lý kho</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.8rem;"></i>
                    </a>

                    <div class="collapse @(isProductMenuOpen ? "show" : "")" id="subMenuProduct">
                        <ul class="nav flex-column" style="background-color: rgba(0,0,0,0.2);">
                            <li>
                                <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                                   class="ps-5 py-2 @(currentCtrl == "Category" ? "text-warning fw-bold" : "")" style="font-size: 0.95rem;">
                                    <i class="bi bi-tags me-2"></i> Danh mục
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                                   class="ps-5 py-2 @(currentCtrl == "Product" ? "text-warning fw-bold" : "")" style="font-size: 0.95rem;">
                                    <i class="bi bi-list-ul me-2"></i> Sản phẩm
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <li>
                    <a asp-area="Admin" asp-controller="Supplier" asp-action="Index"
                       class="@(currentCtrl == "Supplier" ? "active" : "")">
                        <i class="bi bi-truck me-2"></i> Nhà cung cấp
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Promotion" asp-action="Index"
                       class="@(currentCtrl == "Promotion" ? "active" : "")">
                        <i class="bi bi-ticket-perforated me-2"></i> Khuyến mãi
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                       class="@(currentCtrl == "Order" ? "active" : "")">
                        <i class="bi bi-cart me-2"></i> Đơn hàng
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Payment" asp-action="Index"
                       class="@(currentCtrl == "Payment" ? "active" : "")">
                        <i class="bi bi-wallet2 me-2"></i> Thanh toán
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Customer" asp-action="Index"
                       class="@(currentCtrl == "Customer" ? "active" : "")">
                        <i class="bi bi-people me-2"></i> Khách hàng
                    </a>
                </li>

                <li>
                    <a href="#subMenuUser" data-bs-toggle="collapse"
                       class="d-flex justify-content-between align-items-center @(isUserMenuOpen ? "active" : "")"
                       aria-expanded="@(isUserMenuOpen ? "true" : "false")">
                        <span><i class="bi bi-person-badge me-2"></i> Tài khoản</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.8rem;"></i>
                    </a>

                    <div class="collapse @(isUserMenuOpen ? "show" : "")" id="subMenuUser">
                        <ul class="nav flex-column" style="background-color: rgba(0,0,0,0.2);">
                            <li>
                                <a asp-area="Admin" asp-controller="User" asp-action="Index" asp-route-type="employee"
                                   class="ps-5 py-2 @(currentCtrl == "User" && (string.IsNullOrEmpty(currentType) || currentType == "employee") ? "text-warning fw-bold" : "")"
                                   style="font-size: 0.95rem;">
                                    <i class="bi bi-person-workspace me-2"></i> Nhân viên
                                </a>
                            </li>
                            <li>
                                <a asp-area="Admin" asp-controller="User" asp-action="Index" asp-route-type="customer"
                                   class="ps-5 py-2 @(currentCtrl == "User" && currentType == "customer" ? "text-warning fw-bold" : "")"
                                   style="font-size: 0.95rem;">
                                    <i class="bi bi-person me-2"></i> Khách hàng (User)
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>

        <div class="main-panel">
            @* <div class="top-navbar d-flex justify-content-between align-items-center"> *@
            @*     <span class="h5 mb-0">Xin chào, <strong>Admin</strong></span> *@
            @*     <button class="btn btn-outline-danger btn-sm">Đăng xuất</button> *@
            @* </div> *@
            <ul class="navbar-nav ms-auto">
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Xin chào, @User.Identity.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/Admin/Account/Logout">Đăng xuất</a></li>
                        </ul>
                    </li>
                }
            </ul>
            <div class="content-scrollable">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>