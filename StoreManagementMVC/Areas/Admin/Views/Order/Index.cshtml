@model List<Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-primary fw-bold">Danh sách Đơn hàng</h3>

    <div class="d-flex gap-2">
        <form method="get" class="d-flex">
            <input type="text" name="search" value="@search" class="form-control me-2" placeholder="Mã đơn hoặc Tên khách..." style="width: 250px;">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
        </form>
        <a href="/Order/Create" class="btn btn-success shadow-sm">
            <i class="bi bi-cart-plus me-1"></i> Tạo đơn mới
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary">
                <tr>
                    <th class="ps-3">Mã Đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 fw-bold text-primary">#@item.OrderId</td>
                        <td>
                            <div class="fw-bold">@(item.Customer?.Name ?? "Khách lẻ")</div>
                            <small class="text-muted">@(item.Customer?.Phone)</small>
                        </td>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end fw-bold">@item.TotalAmount.ToString("N0") ₫</td>
                        <td class="text-center">
                            @if (item.Status == "paid")
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else if (item.Status == "pending")
                            {
                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="/Order/Details/@item.OrderId" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { p = currentPage - 1, search = search })">Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(currentPage == i ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { p = i, search = search })">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { p = currentPage + 1, search = search })">Sau</a>
            </li>
        </ul>
    </nav>
}