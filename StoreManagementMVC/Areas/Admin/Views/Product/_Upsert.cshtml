@using Store.Shared.Entities
@model Product

<form id="upsertForm" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ImageUrl" />

    <div class="row">
        <div class="col-md-4 text-center">
            <label class="form-label fw-bold">Hình ảnh</label>
            <div class="card shadow-sm mb-3">
                <div class="card-body p-2 d-flex align-items-center justify-content-center bg-light" style="height: 250px;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img id="imgPreview" src="@Model.ImageUrl" class="img-fluid" style="max-height: 100%;" onerror="this.src='/images/default-image.png'" />
                    }
                    else
                    {
                        <img id="imgPreview" src="/images/default-image.png" class="img-fluid" style="max-height: 100%; opacity: 0.8;" />
                    }
                </div>
            </div>
            <input type="file" name="file" class="form-control" onchange="previewImage(this)" accept="image/*" />
        </div>

        <div class="col-md-8">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input asp-for="ProductName" class="form-control" placeholder="VD: Kẹo dẻo Haribo" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Mã vạch</label>
                    <input asp-for="Barcode" class="form-control font-monospace" placeholder="Quét hoặc nhập mã..." />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Đơn vị tính <span class="text-danger">*</span></label>
                    <input asp-for="Unit" class="form-control" placeholder="cái, hộp, kg..." required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Giá bán <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input asp-for="Price" type="number" class="form-control fw-bold text-success" min="0" required />
                        <span class="input-group-text">VNĐ</span>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    @if (Model.ProductId > 0)
                    {
                        // ĐANG EDIT: Chỉ hiển thị xem, không cho sửa trực tiếp (để tránh lệch kho)
                        // Lấy tồn kho từ quan hệ Inventory (nếu có)
                        int currentQty = Model.Inventory?.Quantity ?? 0;
                        <label class="form-label fw-bold">Tồn kho hiện tại</label>
                        <input type="text" class="form-control bg-light" value="@currentQty" readonly />
                        <small class="text-muted fst-italic">Để sửa kho, vui lòng dùng chức năng Nhập/Xuất kho</small>
                    }
                    else
                    {
                        // ĐANG TẠO MỚI: Cho nhập tồn đầu kỳ
                        <label class="form-label fw-bold">Tồn kho ban đầu</label>
                        <input type="number" name="InitialStock" class="form-control" value="0" min="0" />
                        <small class="text-muted fst-italic">*Nhập số lượng khởi tạo</small>
                    }
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Danh mục</label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Nhà cung cấp</label>
                    <select asp-for="SupplierId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Suppliers, "SupplierId", "Name"))">
                        <option value="">-- Chọn NCC --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="text-end border-top pt-3 mt-3">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Lưu lại</button>
    </div>
</form>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                $('#imgPreview').attr('src', e.target.result).css('opacity', '1');
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>